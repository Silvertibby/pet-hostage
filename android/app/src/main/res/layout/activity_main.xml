<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:id="@+id/root" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
        <TextView style="@style/PH.Title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="PET HOSTAGE SYNC" />
        <TextView android:id="@+id/ver" style="@style/PH.Dim" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <ImageView android:id="@+id/bunny" android:layout_width="150dp" android:layout_height="150dp" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp"
        android:src="@drawable/bunny" android:scaleType="fitCenter" android:background="@drawable/card" android:padding="3dp" android:contentDescription="bunny" />

    <TextView android:id="@+id/tagline" style="@style/PH.Dim" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="10dp"
        android:text="Sends your steps to The Raccoon. Garmin → Health Connect → here → your pet." />

    <!-- ===== SETUP ===== -->
    <LinearLayout android:id="@+id/setup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView style="@style/PH.H" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1. YOUR SYNC CODE" />
        <TextView style="@style/PH.Dim" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Easiest: in Pet Hostage, open Step sync and tap “Set up Android sync”. Or paste your code (or sync link) here." />
        <EditText android:id="@+id/codeInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:background="@drawable/field" android:padding="12dp" android:hint="e.g. AB3K7XYZ9Q" android:inputType="textCapCharacters|textNoSuggestions"
            android:fontFamily="@font/press_start" android:textSize="14sp" android:textColor="@color/ink" android:singleLine="true" android:imeOptions="actionDone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/paste" style="@style/PH.Btn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Paste" android:layout_marginEnd="8dp" />
            <Button android:id="@+id/connect" style="@style/PH.Btn.Acc" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:text="Connect" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== HEALTH CONNECT (shown when something's missing) ===== -->
    <LinearLayout android:id="@+id/hc" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/hcTitle" style="@style/PH.H" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2. ALLOW STEPS" />
        <TextView android:id="@+id/hcText" style="@style/PH.Body" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/hcButton" style="@style/PH.Btn.Acc" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Allow steps" />
    </LinearLayout>

    <!-- ===== STATUS ===== -->
    <LinearLayout android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/petLine" style="@style/PH.H" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TODAY" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card" android:padding="16dp">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
                <TextView android:id="@+id/steps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/press_start" android:textSize="26sp" android:textColor="@color/ink" android:text="—" />
                <TextView android:id="@+id/goal" style="@style/PH.Dim" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" />
            </LinearLayout>
            <ProgressBar android:id="@+id/bar" style="@android:style/Widget.Material.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="14dp" android:layout_marginTop="10dp"
                android:max="10000" android:progressTint="@color/acc" android:progressBackgroundTint="#2F2742" />
            <TextView android:id="@+id/lastSync" style="@style/PH.Dim" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" />
            <TextView android:id="@+id/error" style="@style/PH.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/bad" android:visibility="gone" />
        </LinearLayout>
        <Button android:id="@+id/syncNow" style="@style/PH.Btn.Acc" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sync now" />
        <Button android:id="@+id/openGame" style="@style/PH.Btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open Pet Hostage" />
        <TextView android:id="@+id/bgInfo" style="@style/PH.Dim" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
            <TextView android:id="@+id/hcSettings" style="@style/PH.Dim" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:padding="6dp" android:text="Health Connect ›" android:textColor="@color/acc" />
            <TextView android:id="@+id/changeCode" style="@style/PH.Dim" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="6dp" android:text="Change code" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</ScrollView>
